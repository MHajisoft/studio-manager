<Application x:Class="StudioManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <!-- Same IRANSans(FaNum) wiring as sound-recorder -->
        <FontFamily x:Key="StudioFont">pack://application:,,,/Assets/Fonts/IRANSans(FaNum).ttf#IRANSans(FaNum)</FontFamily>

        <SolidColorBrush x:Key="ShellBackground" Color="#12141A"/>
        <SolidColorBrush x:Key="ShellSurface" Color="#1C1F27"/>
        <SolidColorBrush x:Key="ShellElevated" Color="#262A34"/>
        <SolidColorBrush x:Key="ShellBorder" Color="#343845"/>
        <SolidColorBrush x:Key="ShellForeground" Color="#EDEFF4"/>
        <SolidColorBrush x:Key="ShellMuted" Color="#8B92A5"/>
        <SolidColorBrush x:Key="ShellAccent" Color="#2F9E7B"/>
        <SolidColorBrush x:Key="ShellDanger" Color="#D64545"/>
        <SolidColorBrush x:Key="ShellWarn" Color="#D4A017"/>

        <Style TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
        </Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Background" Value="{StaticResource ShellBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ShellForeground}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ShellMuted}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="StudioButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303545"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A4050"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="Background" Value="{StaticResource ShellAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellAccent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="Background" Value="{StaticResource ShellDanger}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellDanger}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PtzButton" TargetType="RepeatButton">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303545"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource ShellAccent}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Background" Value="{StaticResource ShellSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellMuted}"/>
        </Style>
    </Application.Resources>
</Application>
