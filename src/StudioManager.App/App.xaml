<Application x:Class="StudioManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Startup="Application_Startup">
    <Application.Resources>
        <!--
          Cool operator desk — mid-contrast dark (no bright cream, no mustard glare, no white wells).
          Text: soft cool gray on charcoal. Actions: deep teal / deep red with white labels.
        -->
        <FontFamily x:Key="StudioFont">pack://application:,,,/Assets/Fonts/IRANSans(FaNum).ttf#IRANSans(FaNum)</FontFamily>

        <Color x:Key="C.Background">#1B1E24</Color>
        <Color x:Key="C.Surface">#242830</Color>
        <Color x:Key="C.Elevated">#2E333D</Color>
        <Color x:Key="C.Hover">#3A404C</Color>
        <Color x:Key="C.Pressed">#454C5A</Color>
        <Color x:Key="C.Border">#4E5666</Color>
        <Color x:Key="C.BorderSoft">#353B48</Color>
        <Color x:Key="C.Foreground">#D8DCE5</Color>
        <Color x:Key="C.Muted">#9AA3B2</Color>
        <Color x:Key="C.Accent">#3D6F8C</Color>
        <Color x:Key="C.AccentHover">#4A82A0</Color>
        <Color x:Key="C.AccentForeground">#F2F6FA</Color>
        <Color x:Key="C.Danger">#8E3B38</Color>
        <Color x:Key="C.DangerHover">#A44844</Color>
        <Color x:Key="C.DangerForeground">#F7F0EF</Color>
        <Color x:Key="C.Warn">#A8843E</Color>
        <Color x:Key="C.Success">#4F8A66</Color>
        <Color x:Key="C.PreviewWell">#15181D</Color>

        <SolidColorBrush x:Key="ShellBackground" Color="{StaticResource C.Background}"/>
        <SolidColorBrush x:Key="ShellSurface" Color="{StaticResource C.Surface}"/>
        <SolidColorBrush x:Key="ShellElevated" Color="{StaticResource C.Elevated}"/>
        <SolidColorBrush x:Key="ShellHover" Color="{StaticResource C.Hover}"/>
        <SolidColorBrush x:Key="ShellPressed" Color="{StaticResource C.Pressed}"/>
        <SolidColorBrush x:Key="ShellBorder" Color="{StaticResource C.Border}"/>
        <SolidColorBrush x:Key="ShellBorderSoft" Color="{StaticResource C.BorderSoft}"/>
        <SolidColorBrush x:Key="ShellForeground" Color="{StaticResource C.Foreground}"/>
        <SolidColorBrush x:Key="ShellMuted" Color="{StaticResource C.Muted}"/>
        <SolidColorBrush x:Key="ShellAccent" Color="{StaticResource C.Accent}"/>
        <SolidColorBrush x:Key="ShellAccentHover" Color="{StaticResource C.AccentHover}"/>
        <SolidColorBrush x:Key="ShellAccentForeground" Color="{StaticResource C.AccentForeground}"/>
        <SolidColorBrush x:Key="ShellDanger" Color="{StaticResource C.Danger}"/>
        <SolidColorBrush x:Key="ShellDangerHover" Color="{StaticResource C.DangerHover}"/>
        <SolidColorBrush x:Key="ShellDangerForeground" Color="{StaticResource C.DangerForeground}"/>
        <SolidColorBrush x:Key="ShellWarn" Color="{StaticResource C.Warn}"/>
        <SolidColorBrush x:Key="ShellSuccess" Color="{StaticResource C.Success}"/>
        <SolidColorBrush x:Key="ShellPreviewWell" Color="{StaticResource C.PreviewWell}"/>

        <Style x:Key="StudioFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-2" Stroke="{StaticResource ShellMuted}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
        </Style>
        <Style TargetType="{x:Type Window}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Background" Value="{StaticResource ShellBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ShellForeground}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ShellAccent}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ShellMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fully dark ComboBox (no system-white popup) -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        Background="{StaticResource ShellElevated}"
                        BorderBrush="{StaticResource ShellBorder}"
                        BorderThickness="1"
                        CornerRadius="3"/>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 6 6 L 12 0 Z"
                      Fill="{StaticResource ShellMuted}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ShellMuted}"/>
                    <Setter TargetName="Border" Property="Background" Value="{StaticResource ShellHover}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ShellMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,4,32,4"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     Visibility="Hidden"
                                     Background="{StaticResource ShellElevated}"
                                     Foreground="{StaticResource ShellForeground}"
                                     CaretBrush="{StaticResource ShellForeground}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="10,4,32,4"
                                     Focusable="True"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{StaticResource ShellSurface}"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource ShellBorder}"
                                            CornerRadius="3"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ShellMuted}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="StudioButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="Background" Value="{StaticResource ShellAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellAccent}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellAccentForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellAccentHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ShellAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="Background" Value="{StaticResource ShellDanger}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellDanger}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellDangerForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellDangerHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ShellDangerHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary: same dark fill as chrome — readable, no transparent wash -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
        </Style>

        <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource StudioButton}">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,12"/>
        </Style>
        <Style x:Key="TransportAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,12"/>
        </Style>
        <Style x:Key="TransportDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,12"/>
        </Style>

        <Style x:Key="PtzButton" TargetType="RepeatButton">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource StudioFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource ShellAccentForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PtzStopButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Background" Value="{StaticResource ShellElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ShellPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource ShellAccent}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="StatusBar">
            <Setter Property="FontFamily" Value="{StaticResource StudioFont}"/>
            <Setter Property="Background" Value="{StaticResource ShellSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource ShellMuted}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="ConsolePanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShellSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="PreviewFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShellPreviewWell}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <Style x:Key="TransportRail" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShellSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Application.Resources>
</Application>
