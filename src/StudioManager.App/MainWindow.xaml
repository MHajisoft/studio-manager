<Window x:Class="StudioManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:services="clr-namespace:StudioManager.App.Services"
        Title="{Binding [App_Title]}"
        FlowDirection="{Binding FlowDirection}"
        Height="860"
        Width="1440"
        MinHeight="700"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Images/app-icon.ico"
        DataContext="{x:Static services:LocalizationManager.Instance}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Closed="Window_Closed">

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding [Language]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LanguageCombo"
                              Width="120"
                              ItemsSource="{Binding AvailableLanguages}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Culture"
                              SelectionChanged="LanguageCombo_SelectionChanged"/>
                    <TextBlock x:Name="RecorderCountText" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="640"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="SpawnRecorderButton"
                                Content="{Binding [SpawnRecorder]}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,8,0"
                                Click="SpawnRecorder_Click"/>
                        <Button x:Name="ExportUsbButton"
                                Content="{Binding [ExportUsb]}"
                                Style="{StaticResource StudioButton}"
                                Click="ExportUsb_Click"/>
                    </StackPanel>
                    <TextBlock Text="{Binding [StudioDesk]}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="Black"
                        BorderBrush="{StaticResource ShellBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="PreviewView"/>
                        <TextBlock x:Name="PreviewPlaceholder"
                                   Text="{Binding [PreviewOffline]}"
                                   Foreground="{StaticResource ShellMuted}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="LiveButton" Content="{Binding [Live]}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="LiveToggle_Click"/>
                    <Button Grid.Column="1" x:Name="RecordButton" Content="{Binding [Record]}" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="RecordToggle_Click"/>
                    <Button Grid.Column="2" x:Name="SnapshotButton" Content="{Binding [Snapshot]}" Style="{StaticResource StudioButton}" Margin="0,0,8,0" Click="Snapshot_Click"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="Monitor2Check" Content="{Binding [Monitor2]}" Margin="0,0,12,0" Checked="Monitor2_Changed" Unchecked="Monitor2_Changed"/>
                        <CheckBox x:Name="Monitor3Check" Content="{Binding [Monitor3]}" Checked="Monitor3_Changed" Unchecked="Monitor3_Changed"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="2"
                    Background="{StaticResource ShellSurface}"
                    BorderBrush="{StaticResource ShellBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding [CameraPtz]}" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="{Binding [Speed]}" Foreground="{StaticResource ShellMuted}" Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Text="0.5" Width="32" TextAlignment="Right"/>
                            <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SpeedSlider_ValueChanged"/>
                        </DockPanel>

                        <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <RepeatButton Grid.Row="0" Grid.Column="0" Content="↖" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="-1,1,0"/>
                            <RepeatButton Grid.Row="0" Grid.Column="1" Content="↑" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="0,1,0"/>
                            <RepeatButton Grid.Row="0" Grid.Column="2" Content="↗" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="1,1,0"/>
                            <RepeatButton Grid.Row="1" Grid.Column="0" Content="←" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="-1,0,0"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="■" Style="{StaticResource StudioButton}" Width="40" Height="40" Margin="2" Click="PtzStop_Click"/>
                            <RepeatButton Grid.Row="1" Grid.Column="2" Content="→" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="1,0,0"/>
                            <RepeatButton Grid.Row="2" Grid.Column="0" Content="↙" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="-1,-1,0"/>
                            <RepeatButton Grid.Row="2" Grid.Column="1" Content="↓" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="0,-1,0"/>
                            <RepeatButton Grid.Row="2" Grid.Column="2" Content="↘" Style="{StaticResource PtzButton}" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="1,-1,0"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <RepeatButton x:Name="ZoomOutButton" Content="{Binding [ZoomOut]}" Style="{StaticResource PtzButton}" Width="80" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="0,0,-1"/>
                            <RepeatButton x:Name="ZoomInButton" Content="{Binding [ZoomIn]}" Style="{StaticResource PtzButton}" Width="80" PreviewMouseLeftButtonDown="Ptz_Down" PreviewMouseLeftButtonUp="Ptz_Up" Tag="0,0,1"/>
                        </StackPanel>

                        <TextBlock Text="{Binding [Presets]}" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{Binding [Save]}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" Click="SavePreset_Click"/>
                            <TextBox x:Name="PresetNameBox" />
                        </DockPanel>

                        <ListBox x:Name="PresetList"
                                 Height="160"
                                 DisplayMemberPath="Name"
                                 MouseDoubleClick="PresetList_DoubleClick"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{Binding [Go]}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="GotoPreset_Click"/>
                            <Button Content="{Binding [Delete]}" Style="{StaticResource StudioButton}" Click="DeletePreset_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                        <TextBlock Text="{Binding [OpenRecorders]}" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding [OpenRecordersHint]}"
                                   Foreground="{StaticResource ShellMuted}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="OpenRecordersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2" Foreground="{StaticResource ShellForeground}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
