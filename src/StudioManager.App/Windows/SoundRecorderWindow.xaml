<Window x:Class="StudioManager.App.Windows.SoundRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:StudioManager.App.Converters"
        Title="Sound Recorder"
        Height="360"
        Width="420"
        MinHeight="320"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/Images/app-icon.ico"
        Background="{StaticResource ShellSurface}"
        Closed="Window_Closed">

    <Window.Resources>
        <converters:SegmentHeightConverter x:Key="SegmentHeightConverter"/>

        <Style x:Key="LevelMeterStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="Transparent" SnapsToDevicePixels="True">
                            <Grid x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Rectangle Fill="#2F9E7B" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="Green">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                                <Rectangle Fill="#D4A017" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <Rectangle.Margin>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="OrangeMargin">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Margin>
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="Orange">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                                <Rectangle Fill="#D64545" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <Rectangle.Margin>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="RedMargin">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Margin>
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="Red">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14" FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.RowSpan="5" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
            <ProgressBar x:Name="RightLevelMeter" Width="10" Margin="0,4,4,4" Minimum="0" Maximum="100" Orientation="Vertical" VerticalAlignment="Stretch" Style="{StaticResource LevelMeterStyle}"/>
            <ProgressBar x:Name="LeftLevelMeter" Width="10" Margin="0,4,0,4" Minimum="0" Maximum="100" Orientation="Vertical" VerticalAlignment="Stretch" Style="{StaticResource LevelMeterStyle}"/>
        </StackPanel>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="منبع:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SourceComboBox" Margin="0,0,0,8" FlowDirection="LeftToRight" SelectionChanged="SourceComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="آلبوم:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AlbumComboBox" Margin="0,0,0,8" IsEditable="True"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="ژانر:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="GenreComboBox" Margin="0,0,0,8" IsEditable="True"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="خواننده:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SingerComboBox" Margin="0,0,0,8" IsEditable="True"
                  SelectionChanged="SingerComboBox_SelectionChanged"
                  TextBoxBase.TextChanged="SingerComboBox_TextChanged"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="فایل:" VerticalAlignment="Center" Margin="0,0,8,8"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="FileNameTextBox" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" FlowDirection="LeftToRight">
            <TextBlock x:Name="RecordingTimeText" Text="00:00:00" Foreground="{StaticResource ShellDanger}" FontSize="28" VerticalAlignment="Center" Width="140" TextAlignment="Center"/>
            <Button x:Name="StartButton" Width="56" Height="56" Margin="8,0" Style="{StaticResource StudioButton}" Click="StartButton_Click" ToolTip="Start">
                <Image Source="pack://application:,,,/Assets/Images/start.png" Stretch="Uniform"/>
            </Button>
            <Button x:Name="StopButton" Width="56" Height="56" Margin="8,0" Style="{StaticResource StudioButton}" Click="StopButton_Click" ToolTip="Stop" Visibility="Collapsed">
                <Image Source="pack://application:,,,/Assets/Images/stop.png" Stretch="Uniform"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
