<Window x:Class="StudioManager.App.Windows.SoundRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:StudioManager.App.Converters"
        xmlns:services="clr-namespace:StudioManager.App.Services"
        DataContext="{x:Static services:LocalizationManager.Instance}"
        FlowDirection="{Binding FlowDirection}"
        Height="380"
        Width="440"
        MinHeight="340"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/Images/app-icon.ico"
        Background="{StaticResource ShellBackground}"
        Closed="Window_Closed">

    <Window.Resources>
        <converters:SegmentHeightConverter x:Key="SegmentHeightConverter"/>

        <Style x:Key="LevelMeterStyle" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{StaticResource ShellElevated}"
                                BorderBrush="{StaticResource ShellBorderSoft}"
                                BorderThickness="1"
                                CornerRadius="1"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="Root" Margin="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Rectangle Fill="{StaticResource ShellSuccess}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="Green">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                                <Rectangle Fill="{StaticResource ShellWarn}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <Rectangle.Margin>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="OrangeMargin">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Margin>
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="Orange">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                                <Rectangle Fill="{StaticResource ShellDanger}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <Rectangle.Margin>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="RedMargin">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Margin>
                                    <Rectangle.Height>
                                        <MultiBinding Converter="{StaticResource SegmentHeightConverter}" ConverterParameter="Red">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding ElementName="Root" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Rectangle.Height>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ConsolePanel}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.RowSpan="5" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                <ProgressBar x:Name="RightLevelMeter" Width="12" Margin="0,2,5,2" Minimum="0" Maximum="100" Orientation="Vertical" VerticalAlignment="Stretch" Style="{StaticResource LevelMeterStyle}"/>
                <ProgressBar x:Name="LeftLevelMeter" Width="12" Margin="0,2,0,2" Minimum="0" Maximum="100" Orientation="Vertical" VerticalAlignment="Stretch" Style="{StaticResource LevelMeterStyle}"/>
            </StackPanel>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Recorder_Source]}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource ShellMuted}" FontSize="12"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SourceComboBox" Margin="0,0,0,10" FlowDirection="LeftToRight" SelectionChanged="SourceComboBox_SelectionChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Recorder_Album]}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource ShellMuted}" FontSize="12"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AlbumComboBox" Margin="0,0,0,10" IsEditable="True"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [Recorder_Genre]}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource ShellMuted}" FontSize="12"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="GenreComboBox" Margin="0,0,0,10" IsEditable="True"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [Recorder_Singer]}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource ShellMuted}" FontSize="12"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SingerComboBox" Margin="0,0,0,10" IsEditable="True"
                      SelectionChanged="SingerComboBox_SelectionChanged"
                      TextBoxBase.TextChanged="SingerComboBox_TextChanged"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Recorder_File]}" VerticalAlignment="Center" Margin="0,0,10,10" Foreground="{StaticResource ShellMuted}" FontSize="12"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="FileNameTextBox" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" FlowDirection="LeftToRight">
                <TextBlock x:Name="RecordingTimeText" Text="00:00:00" Foreground="{StaticResource ShellDanger}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" Width="140" TextAlignment="Center"/>
                <Button x:Name="StartButton" Width="56" Height="56" Margin="8,0" Style="{StaticResource AccentButton}" Click="StartButton_Click" ToolTip="{Binding [Recorder_Start]}" Padding="10">
                    <Image Source="pack://application:,,,/Assets/Images/start.png" Stretch="Uniform"/>
                </Button>
                <Button x:Name="StopButton" Width="56" Height="56" Margin="8,0" Style="{StaticResource DangerButton}" Click="StopButton_Click" ToolTip="{Binding [Recorder_Stop]}" Visibility="Collapsed" Padding="10">
                    <Image Source="pack://application:,,,/Assets/Images/stop.png" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
