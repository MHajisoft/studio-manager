<Window x:Class="StudioManager.App.Windows.CatalogEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:StudioManager.App.Services"
        DataContext="{x:Static services:LocalizationManager.Instance}"
        FlowDirection="{Binding FlowDirection}"
        Title="{Binding [Catalog_Title]}"
        Width="480"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="{StaticResource ShellBackground}"
        Icon="pack://application:,,,/Assets/Images/app-icon.ico">
    <Border Style="{StaticResource ConsolePanel}" Margin="14">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{Binding [Cancel]}" Style="{StaticResource GhostButton}" MinWidth="88" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="{Binding [Save]}" Style="{StaticResource AccentButton}" MinWidth="88" IsDefault="True" Click="Save_Click"/>
            </StackPanel>

            <TabControl x:Name="CatalogTabs">
                <TabItem Header="{Binding [Catalog_Singers]}">
                    <DockPanel Margin="0,10,0,0">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding [Catalog_Add]}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="AddSinger_Click"/>
                                <Button Content="{Binding [Catalog_Rename]}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="RenameSinger_Click"/>
                                <Button Content="{Binding [Delete]}" Style="{StaticResource DangerButton}" Click="DeleteSinger_Click"/>
                            </StackPanel>
                            <TextBox x:Name="SingerInput" Margin="0,0,8,0"/>
                        </DockPanel>
                        <ListBox x:Name="SingerList" SelectionChanged="SingerList_SelectionChanged"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{Binding [Catalog_Albums]}">
                    <DockPanel Margin="0,10,0,0">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding [Catalog_Add]}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="AddAlbum_Click"/>
                                <Button Content="{Binding [Catalog_Rename]}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="RenameAlbum_Click"/>
                                <Button Content="{Binding [Delete]}" Style="{StaticResource DangerButton}" Click="DeleteAlbum_Click"/>
                            </StackPanel>
                            <TextBox x:Name="AlbumInput" Margin="0,0,8,0"/>
                        </DockPanel>
                        <ListBox x:Name="AlbumList" SelectionChanged="AlbumList_SelectionChanged"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="{Binding [Catalog_Genres]}">
                    <DockPanel Margin="0,10,0,0">
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding [Catalog_Add]}" Style="{StaticResource AccentButton}" Margin="0,0,6,0" Click="AddGenre_Click"/>
                                <Button Content="{Binding [Catalog_Rename]}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="RenameGenre_Click"/>
                                <Button Content="{Binding [Delete]}" Style="{StaticResource DangerButton}" Click="DeleteGenre_Click"/>
                            </StackPanel>
                            <TextBox x:Name="GenreInput" Margin="0,0,8,0"/>
                        </DockPanel>
                        <ListBox x:Name="GenreList" SelectionChanged="GenreList_SelectionChanged"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
