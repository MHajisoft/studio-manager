<Window x:Class="StudioManager.App.Windows.PresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:StudioManager.App.Services"
        DataContext="{x:Static services:LocalizationManager.Instance}"
        FlowDirection="{Binding FlowDirection}"
        Title="{Binding [Presets_ManageTitle]}"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="{StaticResource ShellBackground}"
        Icon="pack://application:,,,/Assets/Images/app-icon.ico">
    <Border Style="{StaticResource ConsolePanel}" Margin="14">
        <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="{Binding [Close]}" Style="{StaticResource AccentButton}" MinWidth="88" IsCancel="True" IsDefault="True" Click="Close_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding [Go]}" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="Go_Click"/>
                    <Button Content="{Binding [Delete]}" Style="{StaticResource GhostButton}" Click="Delete_Click"/>
                </StackPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="{Binding [Save]}" Style="{StaticResource StudioButton}" Margin="8,0,0,0" Click="Save_Click"/>
                <TextBox x:Name="PresetNameBox"/>
            </DockPanel>

            <ListBox x:Name="PresetList"
                     DisplayMemberPath="Name"
                     MouseDoubleClick="PresetList_DoubleClick"/>
        </DockPanel>
    </Border>
</Window>
